{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and role in KKN SPACE",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "member", "dpl", "viewer"] },
        "division": { "type": "string" },
        "nim": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Invitation token for invitation-only access control",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "member", "dpl", "viewer"] },
        "division": { "type": "string" },
        "invitedBy": { "type": "string" },
        "token": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "revoked"] },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["id", "role", "token", "status"]
    },
    "WorkProgram": {
      "title": "WorkProgram",
      "description": "KKN community service work program",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "title": { "type": "string" },
        "division": { "type": "string" },
        "pic": { "type": "string" },
        "objective": { "type": "string" },
        "targetAudience": { "type": "string" },
        "budgetPlanned": { "type": "number" },
        "budgetUsed": { "type": "number" },
        "progressPercent": { "type": "number" },
        "status": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "location": { "type": "string" },
        "isFeaturedInPublic": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "division", "status"]
    },
    "Task": {
      "title": "Task",
      "description": "Coordination task for team members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignee": { "type": "string" },
        "division": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "status": { "type": "string", "enum": ["todo", "in_progress", "review", "done"] },
        "dueDate": { "type": "string" }
      },
      "required": ["id", "title", "status", "priority"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Internal and village coordination meeting agenda and minutes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string" },
        "notesSummary": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "date", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial ledger record of cash in and cash out",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "recordedBy": { "type": "string" }
      },
      "required": ["id", "date", "type", "category", "amount", "description"]
    },
    "PublicFeedback": {
      "title": "PublicFeedback",
      "description": "Feedback and aspirations submitted by villagers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "dusun": { "type": "string" },
        "role": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "reviewed"] }
      },
      "required": ["id", "name", "dusun", "message", "status"]
    },
    "Member": {
      "title": "Member",
      "description": "Verified KKN Pringgasela Selatan team member profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "division": { "type": "string" },
        "nim": { "type": "string" },
        "major": { "type": "string" },
        "phone": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "avatar": { "type": "string" },
        "responsibilities": { "type": "array" },
        "invitationToken": { "type": "string" },
        "accountStatus": { "type": "string", "enum": ["pending_invitation", "active"] },
        "systemRole": { "type": "string", "enum": ["admin", "member", "dpl", "viewer"] }
      },
      "required": ["id", "name", "role", "division", "phone"]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/Member" },
      "description": "KKN team member records stored in Cloud Firestore"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Authenticated user profiles"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Admin authorization registry document"
    },
    "/invitations/{invitationId}": {
      "schema": { "$ref": "#/entities/Invitation" },
      "description": "Admin-issued invitation tokens for role-based onboarding"
    },
    "/programs/{programId}": {
      "schema": { "$ref": "#/entities/WorkProgram" },
      "description": "Work programs managed by KKN unit"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Operational tasks for divisions"
    },
    "/meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/Meeting" },
      "description": "Meeting agendas and notulensi records"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Buku Kas financial transactions"
    },
    "/publicFeedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/PublicFeedback" },
      "description": "Aspirasi and feedback from village residents"
    }
  }
}
