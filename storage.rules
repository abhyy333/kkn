rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Documentation & Gallery Photos
    match /documentation/{fileName} {
      allow read: if true; // Publicly visible in gallery and public portal
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024 // max 10MB
        && request.resource.contentType.matches('image/.*');
    }

    // Member Avatars
    match /avatars/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'abhyy333@gmail.com')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Archive Documents (Reports, SK, PDF)
    match /archive/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024; // max 25MB
    }
  }
}
