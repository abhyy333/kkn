rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isDpl() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dpl';
    }

    function canWriteWorkspace() {
      return isSignedIn() && (
        isAdmin() ||
        !isDpl()
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. User Profiles: PII Isolation & RBAC Protection
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(userId) && isOwner(userId) &&
        incoming().uid == userId &&
        incoming().email is string &&
        incoming().email.size() <= 128 &&
        ((incoming().role in ['member', 'dpl', 'viewer']) || isAdmin());
      allow update: if isValidId(userId) && (
        (isOwner(userId) && incoming().uid == existing().uid && (isAdmin() || incoming().role == existing().role || (existing().role == 'admin' && incoming().role == 'member'))) ||
        isAdmin()
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 2. Admins Registry: Restricted strictly to current Admins (or voluntary self-drop)
    match /admins/{userId} {
      allow read: if isValidId(userId) && (isAdmin() || isOwner(userId));
      allow create, update: if isValidId(userId) && isAdmin();
      allow delete: if isValidId(userId) && (isAdmin() || isOwner(userId));
    }

    // 3. Invitations: Invitation-Only Access Gate
    match /invitations/{invitationId} {
      allow get: if isValidId(invitationId);
      allow list: if isSignedIn();
      allow create, delete: if isValidId(invitationId) && isAdmin();
      allow update: if isValidId(invitationId) && (
        isAdmin() ||
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedAt', 'acceptedByUid', 'email']) && incoming().status == 'accepted')
      );
    }

    // 4. Public Feedback / Aspirasi Warga
    match /publicFeedback/{feedbackId} {
      allow read: if isValidId(feedbackId);
      allow create: if isValidId(feedbackId) &&
        incoming().name is string && incoming().name.size() <= 100 &&
        incoming().message is string && incoming().message.size() <= 1000 &&
        incoming().dusun is string && incoming().dusun.size() <= 50;
      allow update, delete: if isValidId(feedbackId) && canWriteWorkspace();
    }

    // 5. Work Programs (Public reads approved, Workspace writes authenticated non-DPL)
    match /programs/{programId} {
      allow get, list: if isSignedIn() || (resource.data.isFeaturedInPublic == true);
      allow create, update, delete: if isValidId(programId) && canWriteWorkspace();
    }

    // Team Members Directory (Managed strictly by Admins, read by workspace, activation allowed by claimer)
    match /members/{memberId} {
      allow get: if isValidId(memberId);
      allow list: if true;
      allow create, delete: if isValidId(memberId) && isAdmin();
      allow update: if isValidId(memberId) && (
        isAdmin() ||
        (isSignedIn() &&
         incoming().diff(existing()).affectedKeys().hasOnly(['accountStatus', 'authUid', 'email']) &&
         incoming().accountStatus == 'active' &&
         incoming().authUid == request.auth.uid)
      );
    }

    // 6. Private Workspace Collections (DPL has Read-Only, Members & Admins have Write)
    match /tasks/{taskId} {
      allow read: if isValidId(taskId) && isSignedIn();
      allow write: if isValidId(taskId) && canWriteWorkspace();
    }

    match /meetings/{meetingId} {
      allow read: if isValidId(meetingId) && isSignedIn();
      allow write: if isValidId(meetingId) && canWriteWorkspace();
    }

    match /transactions/{transactionId} {
      allow read: if isValidId(transactionId) && isSignedIn();
      allow write: if isValidId(transactionId) && canWriteWorkspace();
    }

    match /surveys/{surveyId} {
      allow read: if isValidId(surveyId) && isSignedIn();
      allow write: if isValidId(surveyId) && canWriteWorkspace();
    }

    match /inventory/{itemId} {
      allow read: if isValidId(itemId) && isSignedIn();
      allow write: if isValidId(itemId) && canWriteWorkspace();
    }

    match /documentation/{photoId} {
      allow read: if true; // Public gallery can show documentation photos
      allow write: if isValidId(photoId) && canWriteWorkspace();
    }

    match /reports/{reportId} {
      allow read: if isValidId(reportId) && isSignedIn();
      allow write: if isValidId(reportId) && (canWriteWorkspace() || (isDpl() && incoming().diff(existing()).affectedKeys().hasOnly(['dplNotes', 'status'])));
    }

    match /decisions/{decisionId} {
      allow read: if isValidId(decisionId) && isSignedIn();
      allow write: if isValidId(decisionId) && canWriteWorkspace();
    }

    match /archive/{archiveId} {
      allow read: if isValidId(archiveId) && isSignedIn();
      allow write: if isValidId(archiveId) && canWriteWorkspace();
    }

    match /unitConfig/{configId} {
      allow read: if true; // Config (village name, university) can be read publicly
      allow write: if isValidId(configId) && isAdmin();
    }
  }
}
